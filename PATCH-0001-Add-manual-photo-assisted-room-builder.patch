+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>RescueSphere Room Builder</title>
+    <link rel="stylesheet" href="/src/builder/builder.css" />
+  </head>
+  <body>
+    <main class="builder">
+      <header>
+        <h1>Room builder</h1>
+        <p class="lede">
+          Use a photo or video frame as a reference, set a scale, then place furniture and exits on the plan.
+          Every item here is one you placed. Sizes from photos are estimates.
+        </p>
+      </header>
+
+      <section aria-labelledby="step-photo">
+        <h2 id="step-photo">1. Reference photo</h2>
+        <label class="field">
+          Photo or short video
+          <input id="file-input" type="file" accept="image/*,video/*" />
+        </label>
+        <div id="video-controls" hidden>
+          <label class="field">
+            Pick a frame
+            <input id="frame-slider" type="range" min="0" max="0" step="0.1" value="0" />
+          </label>
+          <video id="frame-video" muted playsinline preload="auto" hidden></video>
+        </div>
+        <canvas id="photo-canvas" class="photo" aria-label="Reference photo. Click to place calibration or measurement points."></canvas>
+        <p id="photo-hint" class="hint">Set the scale first, then measure objects in the photo.</p>
+
+        <div class="row">
+          <button id="calibrate-btn" type="button" aria-pressed="false">Set scale: click two points</button>
+          <label class="field inline">
+            Known length (m)
+            <input id="known-length" type="number" min="0.1" step="0.01" placeholder="e.g. 0.9" />
+          </label>
+          <button id="apply-scale-btn" type="button">Apply scale</button>
+        </div>
+        <p id="scale-status" class="status" role="status"></p>
+
+        <div class="row">
+          <button id="measure-btn" type="button" aria-pressed="false">Measure: click two points</button>
+          <button id="use-width-btn" type="button">Use as width</button>
+          <button id="use-depth-btn" type="button">Use as depth</button>
+        </div>
+        <p id="measure-readout" class="status" role="status"></p>
+      </section>
+
+      <section aria-labelledby="step-plan">
+        <h2 id="step-plan">2. Plan</h2>
+        <div class="row">
+          <label class="field inline">
+            Room width (m)
+            <input id="room-width" type="number" min="1" step="0.1" value="4" />
+          </label>
+          <label class="field inline">
+            Room length (m)
+            <input id="room-length" type="number" min="1" step="0.1" value="5" />
+          </label>
+        </div>
+
+        <div class="row">
+          <label class="field inline">
+            Click on the plan to place a
+            <select id="plan-tool">
+              <option value="furniture">piece of furniture</option>
+              <option value="exit">exit</option>
+            </select>
+          </label>
+        </div>
+
+        <fieldset>
+          <legend>Furniture</legend>
+          <div class="row">
+            <label class="field inline">
+              Type
+              <select id="preset-select"></select>
+            </label>
+            <label class="field inline">
+              Label
+              <input id="furniture-label" type="text" value="Chair" maxlength="40" />
+            </label>
+            <label class="field inline">
+              Width (m)
+              <input id="furniture-width" type="number" min="0.1" step="0.05" value="0.5" />
+            </label>
+            <label class="field inline">
+              Depth (m)
+              <input id="furniture-depth" type="number" min="0.1" step="0.05" value="0.5" />
+            </label>
+          </div>
+        </fieldset>
+
+        <fieldset>
+          <legend>Exit</legend>
+          <div class="row">
+            <label class="field inline">
+              Label
+              <input id="exit-label" type="text" value="Front door" maxlength="40" />
+            </label>
+            <label class="field inline">
+              Kind
+              <select id="exit-type">
+                <option value="primary">Main exit</option>
+                <option value="alternative">Alternative exit</option>
+              </select>
+            </label>
+          </div>
+          <p class="hint">Exits snap to the nearest wall when placed.</p>
+        </fieldset>
+
+        <canvas id="plan-canvas" class="plan" width="480" height="400" aria-label="Top-down room plan. Click to place the selected item."></canvas>
+      </section>
+
+      <section aria-labelledby="step-items">
+        <h2 id="step-items">3. Placed items</h2>
+        <ul id="items-list" class="items"></ul>
+        <h3>Checks</h3>
+        <ul id="issues-list" class="issues" aria-live="polite"></ul>
+        <div class="row">
+          <button id="save-btn" type="button">Save layout to this browser</button>
+        </div>
+        <p id="save-status" class="status" role="status"></p>
+      </section>
+    </main>
+    <script type="module" src="/src/builder/builder.ts"></script>
+  </body>
+</html>
